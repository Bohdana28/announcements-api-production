# PostgreSQL connection string
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/announcements?schema=public"

# Use a random secret of at least 32 characters
JWT_SECRET="replace_this_with_a_long_random_secret_at_least_32_chars"
PORT=3000

# Comma-separated browser origins allowed to call this API
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Cloudinary credentials (required only when uploading announcement images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
